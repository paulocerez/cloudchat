PORT=3001
FRONTEND_URL=http://localhost:5173

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WhatsApp Business API
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
USER_PHONE_NUMBER=1234567890  # Your personal WhatsApp number (with country code, no +)

# Groq
GROQ_API_KEY=your_groq_api_key

# Mapbox (forward geocoding of places mentioned in entries)
MAPBOX_TOKEN=your_mapbox_secret_or_default_token

# Pocket AI (device recordings -> daily entries)
POCKET_API_KEY=pk_xxx
# Shown once when you create the webhook in Pocket. Point the webhook at
# <backend-url>/webhook/pocket. Deliveries are rejected without it set.
POCKET_WEBHOOK_SECRET=your_pocket_webhook_signing_secret

# Hevy (workouts -> daily entries). Pro only; key from hevy.com/settings?developer
HEVY_API_KEY=00000000-0000-0000-0000-000000000000
# Any random string. In hevy.com/settings?developer → Webhooks, set the URL to
# <backend-url>/webhook/hevy and the authorization header to "Bearer <this>".
HEVY_WEBHOOK_TOKEN=your_random_hevy_webhook_token
# Workouts starting before this day (YYYY-MM-DD) are skipped; empty syncs all history.
HEVY_SYNC_FROM=2026-08-08

# Scheduler
CRON_SCHEDULE=0 20 * * *   # 8 PM every day
TZ=Europe/Berlin            # Your timezone
